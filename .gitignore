# Compiled Oak programs and the compiler itself.
# Patterns are root-anchored (leading /) so they only ever match build
# outputs at the repo root — never a same-named source dir like examples/bench/.
*.exe
/oakc
/a.out
/a.exe
/hello
/bump
/copy_ok
/control_flow
/strings
/bad_twice
/demo_spin
/bench

# C emitted by the compiler (<input>.oak.c) and object files
*.oak.c
*.o

# Third-party tools dropped in by the user (e.g. dependencies/tcc/).
# TCC is a complete distribution (tcc.exe + include/ + lib/), so it is either
# vendored in full or not at all - ignoring the whole folder avoids committing
# a broken half. Delete or negate this line to vendor it.
/dependencies/

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
