// Feature coverage for a single compile-and-run check: structs (literal,
// mutation through a parameter, temporary), arrays (literal, len, index,
// negative index, push, empty+annotation), strings (concat, compare, index,
// slice, escapes, struct field), floats/bools/ptr, and one FFI call.
//
// Build:  oakc examples/features.oak -o features
//         oakc examples/features.oak -o features --cc tcc

include "stdio.h";

extern fn printf(fmt: string, ...) -> i32;

struct Point {
    x: i32,
    y: i32,
}

struct Named {
    who: string,
    n: i32,
}

fn shift(p: Point, dx: i32) {
    p.x = p.x + dx;
}

fn sum(a: i32[]) -> i32 {
    var total = 0;
    var i = 0;
    while i < len(a) {
        total = total + a[i];
        i = i + 1;
    }
    return total;
}

fn main() {
    var p = Point { x: 1, y: 2 };
    shift(p, 10);
    print(p.x);                      // 11
    print((Point { x: 5, y: 6 }).y); // 6

    var a: i32[] = [1, 2, 3];
    print(len(a));                   // 3
    print(a[0]);                     // 1
    print(a[-1]);                    // 3
    push(a, 4);
    print(len(a));                   // 4
    print(sum(a));                   // 10

    var empty: i32[] = [];
    push(empty, 42);
    print(empty[0]);                 // 42

    var s = "Hello, " + "world";
    print(s);                        // Hello, world
    print(len(s));                   // 12
    print(s[0]);                     // H
    print(s[-1]);                    // d
    print(s[0:5]);                   // Hello
    print(s[7:]);                    // world
    print(s[:5]);                    // Hello
    if s == "Hello, world" {
        print("eq");
    }
    if s != "x" {
        print("neq");
    }

    var g = Named { who: "Ana", n: 7 };
    print(g.who);                    // Ana

    var f = 1.5 + 2;
    print(f);                        // 3.5
    print(!false);                   // true
    print(null == null);             // true

    printf("%d %s %.2f\n", 7, "via printf", 2.5);
}
