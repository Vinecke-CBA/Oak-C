// for loops: inclusive i32 ranges, f64 ranges, array iteration, nested
// loops, and [field, ...] destructuring over arrays of structs.

struct User {
    name: string,
    age: i32,
}

fn range_sum(lo: i32, hi: i32) -> i32 {
    var tot = 0;
    for x in lo..hi {
        tot = tot + x;
    }
    return tot;
}

fn main() {
    for x in 0..5 {
        print(x);
    }
    print(range_sum(1, 100));      // 5050
    print(range_sum(5, 5));        // 5
    print(range_sum(5, 1));        // 0

    var tot = 0.0;
    for t in 0.0..1.0 {
        tot = tot + t;
    }
    print(tot);                   // 1.0

    var words = ["a", "b", "c"];
    for w in words {
        print(w);
    }

    var grid = 0;
    for r in 1..3 {
        for c in 1..3 {
            grid = grid + r * 10 + c;
        }
    }
    print(grid);                  // 198

    var n = 3;
    for i in 1..n {
        print(i * 100);
    }

    var users = [User { name: "ann", age: 30 }, User { name: "bo", age: 7 }];
    for [name, age] in users {
        print(name);
        print(age + 1000);
    }
    print(len(users));

    for x in 0..2 {
        print(x);
    }
    for x in 3..4 {
        print(x);
    }

    for v in [10, 20] {   // iterate an array literal directly
        print(v);
    }
}
