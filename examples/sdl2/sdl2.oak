extern fn sdl2_window_y(win: ptr) -> i32;
extern fn sdl2_window_id(win: ptr) -> i32;
extern fn sdl2_window_flags(win: ptr) -> i32;
extern fn sdl2_window_from_id(id: i32) -> ptr;
extern fn sdl2_show_window(win: ptr);
extern fn sdl2_hide_window(win: ptr);
extern fn sdl2_maximize_window(win: ptr);
extern fn sdl2_minimize_window(win: ptr);
extern fn sdl2_restore_window(win: ptr);
extern fn sdl2_raise_window(win: ptr);
extern fn sdl2_set_window_bordered(win: ptr, on: bool);
extern fn sdl2_set_window_resizable(win: ptr, on: bool);
extern fn sdl2_set_window_on_top(win: ptr, on: bool);
extern fn sdl2_set_window_keyboard_grab(win: ptr, on: bool);
extern fn sdl2_set_window_mouse_grab(win: ptr, on: bool);
extern fn sdl2_set_window_mouse_rect(win: ptr, x: i32, y: i32, w: i32, h: i32);
extern fn sdl2_set_window_fullscreen(win: ptr, flags: i32);
extern fn sdl2_set_window_minimum_size(win: ptr, w: i32, h: i32);
extern fn sdl2_set_window_maximum_size(win: ptr, w: i32, h: i32);
extern fn sdl2_set_window_opacity(win: ptr, opacity: f64);
extern fn sdl2_window_has_focus(win: ptr) -> bool;
extern fn sdl2_window_has_mouse_focus(win: ptr) -> bool;

// -------------------------- renderers ------------------------

extern fn sdl2_create_renderer(win: ptr, index: i32, flags: i32) -> ptr;
extern fn sdl2_destroy_renderer(ren: ptr);
extern fn sdl2_renderer_name(ren: ptr) -> string;
extern fn sdl2_num_render_drivers() -> i32;
extern fn sdl2_render_driver_name(index: i32) -> string;
extern fn sdl2_render_target_supported(ren: ptr) -> bool;
extern fn sdl2_set_draw_color(ren: ptr, r: i32, g: i32, b: i32, a: i32);
extern fn sdl2_render_clear(ren: ptr);
extern fn sdl2_render_present(ren: ptr);
extern fn sdl2_render_flush(ren: ptr);
extern fn sdl2_set_render_vsync(ren: ptr, on: bool);
extern fn sdl2_set_viewport(ren: ptr, x: i32, y: i32, w: i32, h: i32); // w<0 = whole target
extern fn sdl2_set_logical_size(ren: ptr, w: i32, h: i32);
extern fn sdl2_set_integer_scale(ren: ptr, on: bool);
extern fn sdl2_set_render_scale(ren: ptr, sx: f64, sy: f64);
extern fn sdl2_output_width(ren: ptr) -> i32;
extern fn sdl2_output_height(ren: ptr) -> i32;
extern fn sdl2_set_render_target(ren: ptr, tex: ptr);   // null = back buffer
extern fn sdl2_set_blend_mode(ren: ptr, mode: i32);

// -------------------------- geometry -------------------------

extern fn sdl2_draw_point(ren: ptr, x: i32, y: i32);
extern fn sdl2_draw_line(ren: ptr, x0: i32, y0: i32, x1: i32, y1: i32);
extern fn sdl2_draw_rect(ren: ptr, x: i32, y: i32, w: i32, h: i32);
extern fn sdl2_fill_rect(ren: ptr, x: i32, y: i32, w: i32, h: i32);
extern fn sdl2_draw_circle(ren: ptr, cx: i32, cy: i32, radius: i32);
extern fn sdl2_fill_circle(ren: ptr, cx: i32, cy: i32, radius: i32);

// -------------------------- textures -------------------------

extern fn sdl2_create_texture(ren: ptr, access: i32, w: i32, h: i32) -> ptr;
extern fn sdl2_solid_texture(ren: ptr, w: i32, h: i32, r: i32, g: i32, b: i32, a: i32) -> ptr;
extern fn sdl2_load_bmp(ren: ptr, path: string) -> ptr;
extern fn sdl2_destroy_texture(tex: ptr);
extern fn sdl2_texture_width(tex: ptr) -> i32;
extern fn sdl2_texture_height(tex: ptr) -> i32;
extern fn sdl2_set_texture_color(tex: ptr, r: i32, g: i32, b: i32) -> i32;
extern fn sdl2_set_texture_alpha(tex: ptr, a: i32) -> i32;
extern fn sdl2_set_texture_blend_mode(tex: ptr, mode: i32) -> i32;
extern fn sdl2_fill_texture(tex: ptr, r: i32, g: i32, b: i32, a: i32) -> i32;
// sx < 0 copies the whole texture; dw/dh <= 0 keep the source size.
extern fn sdl2_copy(ren: ptr, tex: ptr, sx: i32, sy: i32, sw: i32, sh: i32,
                    dx: i32, dy: i32, dw: i32, dh: i32);
// cx/cy < 0 rotates around the middle of the destination rect.
extern fn sdl2_copy_ex(ren: ptr, tex: ptr, sx: i32, sy: i32, sw: i32, sh: i32,
                       dx: i32, dy: i32, dw: i32, dh: i32, angle: f64,
                       cx: i32, cy: i32, flip: i32);

// --------------------------- events --------------------------
// Allocate one event handle with sdl2_event_new() and reuse it for the whole
// program; read it back with the sdl2_ev_* accessors.

extern fn sdl2_event_new() -> ptr;
extern fn sdl2_event_free(ev: ptr);
extern fn sdl2_pump_events();
extern fn sdl2_poll_event(ev: ptr) -> i32;    // 1 = event filled in
extern fn sdl2_wait_event(ev: ptr) -> i32;
extern fn sdl2_wait_timeout(ev: ptr, ms: i32) -> i32;
extern fn sdl2_flush_events();
extern fn sdl2_push_quit() -> i32;
extern fn sdl2_ev_type(ev: ptr) -> i32;
extern fn sdl2_ev_window_id(ev: ptr) -> i32;
extern fn sdl2_ev_window_event(ev: ptr) -> i32;
extern fn sdl2_ev_window_data1(ev: ptr) -> i32;
extern fn sdl2_ev_window_data2(ev: ptr) -> i32;
extern fn sdl2_ev_key_scancode(ev: ptr) -> i32;
extern fn sdl2_ev_key_keycode(ev: ptr) -> i32;
extern fn sdl2_ev_key_down(ev: ptr) -> bool;
extern fn sdl2_ev_key_mod(ev: ptr) -> i32;
extern fn sdl2_ev_text(ev: ptr) -> string;    // TEXTINPUT / TEXTEDITING / DROPFILE
extern fn sdl2_ev_mouse_button(ev: ptr) -> i32;
extern fn sdl2_ev_mouse_down(ev: ptr) -> bool;
extern fn sdl2_ev_mouse_x(ev: ptr) -> i32;
extern fn sdl2_ev_mouse_y(ev: ptr) -> i32;
extern fn sdl2_ev_mouse_relx(ev: ptr) -> i32;
extern fn sdl2_ev_mouse_rely(ev: ptr) -> i32;
extern fn sdl2_ev_wheel_x(ev: ptr) -> f64;
extern fn sdl2_ev_wheel_y(ev: ptr) -> f64;
extern fn sdl2_ev_user_code(ev: ptr) -> i32;
extern fn sdl2_ev_user_data1(ev: ptr) -> i32;

// -------------------------- keyboard -------------------------
// sdl2_key_down polls the physical key state; events give you edges + text.

extern fn sdl2_key_down(scancode: i32) -> bool;
extern fn sdl2_scancode_letter(letter: i32) -> i32;  // 'a'..'z' either case
extern fn sdl2_scancode_digit(digit: i32) -> i32;    // 0..9
extern fn sdl2_scancode_key(index: i32) -> i32;      // 1..12 -> F1..F12
extern fn sdl2_scancode_name(scancode: i32) -> string;
extern fn sdl2_keycode_name(keycode: i32) -> string;
extern fn sdl2_keycode_from_scancode(scancode: i32) -> i32;
extern fn sdl2_scancode_from_keycode(keycode: i32) -> i32;
extern fn sdl2_keyboard_focus() -> bool;
extern fn sdl2_text_input(on: bool);

// ---------------------------- mouse --------------------------

extern fn sdl2_mouse_x() -> i32;
extern fn sdl2_mouse_y() -> i32;
extern fn sdl2_mouse_global_x() -> i32;
extern fn sdl2_mouse_global_y() -> i32;
extern fn sdl2_mouse_buttons() -> i32;        // SDL_BUTTON_*MASK bits
extern fn sdl2_mouse_button_down(button: i32) -> bool;
extern fn sdl2_show_cursor(show: bool);
extern fn sdl2_cursor_shown() -> bool;
extern fn sdl2_set_mouse_relative(on: bool);
extern fn sdl2_warp_mouse(win: ptr, x: i32, y: i32);

// --------------------------- timers --------------------------

extern fn sdl2_ticks() -> f64;                // ms since sdl2_init
extern fn sdl2_delay(ms: i32);
extern fn sdl2_perf_counter() -> f64;
extern fn sdl2_perf_freq() -> f64;
extern fn sdl2_time() -> f64;                 // seconds, high resolution


