// Oak wrapper for SDL2: window, renderer, geometry, textures, events,
// keyboard, mouse, timers, and the constants that go with them.
//
// How it is wired up
// ------------------
// SDL2's own headers cannot be used from Oak:
//   * Oak writes its own prototype per `extern fn` (int32_t / double / bool /
//     const char * / void *), which collides with SDL's sized enums
//     (SDL_WindowFlags, SDL_bool) and structs by value (SDL_Rect, SDL_Event);
//   * <SDL2/SDL.h> also #defines `main` to `SDL_main`, so Oak's
//     `int main(void)` would not even compile in a file that includes it.
// So all SDL types stay inside sdl2_shim.c, and Oak calls the `sdl2_*`
// functions there, which speak Oak's types. The shim is compiled and linked
// automatically by the line below — no `--` file arguments needed:
//
//   oakc examples/sdl2/demo_bounce.oak -o demo_bounce -- -lSDL2
//
// (Only the SDL *library* flag is still yours to pass: which library to link
// is a property of the machine, not of this folder. Static builds need
// `sdl2-config --static-libs`, see README.md.)
//
// SDL objects (windows, renderers, textures, events) are `ptr` handles.
// Coordinates are i32, angles/times are f64, colors are (r, g, b) byte tuples.

include "sdl2_shim.c" as extern C;

// --------------------------- core ----------------------------

extern fn sdl2_init(flags: i32) -> i32;
extern fn sdl2_quit();
extern fn sdl2_init_subsystem(flags: i32) -> i32;
extern fn sdl2_quit_subsystem(flags: i32);
extern fn sdl2_error() -> string;
extern fn sdl2_clear_error();
extern fn sdl2_version() -> i32;              // 2030008 == 2.30.8
extern fn sdl2_video_driver() -> string;
extern fn sdl2_num_video_drivers() -> i32;
extern fn sdl2_video_driver_name(index: i32) -> string;
extern fn sdl2_set_hint(name: string, value: string);
extern fn sdl2_get_hint(name: string) -> string;
extern fn sdl2_format(fmt: string, ...) -> string;  // printf into an Oak string
extern fn sdl2_num_allocations() -> i32;

// -------------------------- displays -------------------------

extern fn sdl2_num_displays() -> i32;
extern fn sdl2_display_width(index: i32) -> i32;
extern fn sdl2_display_height(index: i32) -> i32;
extern fn sdl2_display_usable_width(index: i32) -> i32;
extern fn sdl2_display_usable_height(index: i32) -> i32;
extern fn sdl2_display_dpi(index: i32) -> f64;

// --------------------------- windows -------------------------

extern fn sdl2_create_window(title: string, x: i32, y: i32, w: i32, h: i32,
                             flags: i32) -> ptr;
extern fn sdl2_destroy_window(win: ptr);
extern fn sdl2_set_window_title(win: ptr, title: string);
extern fn sdl2_window_title(win: ptr) -> string;
extern fn sdl2_set_window_size(win: ptr, w: i32, h: i32);
extern fn sdl2_window_width(win: ptr) -> i32;
extern fn sdl2_window_height(win: ptr) -> i32;
extern fn sdl2_window_pixel_width(win: ptr) -> i32;
extern fn sdl2_window_pixel_height(win: ptr) -> i32;
extern fn sdl2_set_window_position(win: ptr, x: i32, y: i32);
