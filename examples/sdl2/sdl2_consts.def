/* sdl2_consts.def — SDL2 constant table for the Oak wrapper.
 *
 * X-macro table, included twice: sdl2_shim.h uses it to DECLARE the accessor
 * functions, sdl2_shim.c uses it to DEFINE them. Values are never hardcoded —
 * every entry expands to the real SDL2 macro, so the numbers always match the
 * SDL headers you build against.
 *
 *   OAK_SDL_CONST(name, macro)   -> int32_t      sdl2_<name>(void)
 *   OAK_SDL_HINT(name, macro)    -> const char  *sdl2_<name>(void)
 *
 * Cover another constant? Add one line here and one `extern fn` line in
 * sdl2.oak. That is the whole procedure.
 */

/* --- SDL_Init flags --- */
#ifdef OAK_SDL_CONST
OAK_SDL_CONST(init_timer, SDL_INIT_TIMER)
